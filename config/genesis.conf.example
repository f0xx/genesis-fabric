# Genesis node. Lines starting with # are comments.
bind_host = 0.0.0.0
bind_port = 37420
node_name = genesis
profile = auto
# enable_fec / enable_nack: auto, on, or off.
# auto follows the link: ethernet NACK only, wifi FEC+NACK, cellular neither.
enable_fec = auto
enable_nack = auto
enable_dht = 1
jitter_ms = 0
link = auto
# routes = 192.168.4.101:37420,10.0.0.5:37420
# control = /tmp/genesis.sock
fec_k = 8
fec_r = 1
plain_mss = 1200
window_packets = 512
enable_mesh = true
enable_discovery = true
enable_io_uring = auto
pinned_core = -1
socket_buffer = 8388608
recv_dir = .
trust = any
punch_ms = 2000
transfer_timeout_s = 0
verbose = 0
# stun_host = stun.l.google.com
# stun_port = 19302
# psk = <64 hex chars>
# expect_pub_hex = <64 hex chars of the peer X25519 public key>
# chroot_dir = /var/lib/genesis
# drop_user = genesis
# export = photos /home/foxx/photos rw
# export = pub /srv/pub ro
